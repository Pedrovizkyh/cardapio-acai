# Postgres. Local: o do docker-compose. Produção: a URL direta do Neon (com ?sslmode=require).
DATABASE_URL="postgresql://acai:acai@localhost:5432/acai?schema=public"

# Login de demonstração criado pelo seed.
ADMIN_EMAIL="admin@acaidaorla.com"
ADMIN_SENHA="admin123"

# Segredo que assina os tokens. Em produção, gere um aleatório: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-grande-e-aleatorio"
JWT_EXPIRES_IN="1d"

# Porta da API (o Render define sozinho).
PORT=3000

# Sites que podem chamar a API, separados por vírgula.
CORS_ORIGIN="http://localhost:5173"
